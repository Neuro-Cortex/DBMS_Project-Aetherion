-- ============================================
-- SMART HOSPITAL MANAGEMENT SYSTEM
-- Complete MySQL Database Schema (Fixed)
-- Version: 1.0.2
-- ============================================

CREATE DATABASE IF NOT EXISTS smart_hospital
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

USE smart_hospital;


-- ============================================
-- TABLE 1: USERS
-- ============================================
CREATE TABLE IF NOT EXISTS users (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    uuid CHAR(36) NOT NULL UNIQUE,
    email VARCHAR(255) NOT NULL UNIQUE,
    phone VARCHAR(20) NULL UNIQUE,
    username VARCHAR(100) NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    date_of_birth DATE NULL,
    gender ENUM('male','female','other') NULL,
    blood_group ENUM('A+','A-','B+','B-','AB+','AB-','O+','O-') NULL,
    profile_image VARCHAR(500) NULL,
    nid_number VARCHAR(50) NULL UNIQUE,
    address TEXT NULL,
    city VARCHAR(100) NULL,
    state VARCHAR(100) NULL,
    country VARCHAR(100) DEFAULT 'Bangladesh',
    postal_code VARCHAR(20) NULL,
    latitude DECIMAL(10,8) NULL,
    longitude DECIMAL(11,8) NULL,
    role ENUM('admin','super_admin','doctor','patient','pharmacist','hospital_staff','lab_technician','nurse','receptionist','ambulance_driver') NOT NULL DEFAULT 'patient',
    status ENUM('active','inactive','suspended','banned','pending_verification') NOT NULL DEFAULT 'pending_verification',
    is_email_verified BOOLEAN DEFAULT FALSE,
    is_phone_verified BOOLEAN DEFAULT FALSE,
    is_2fa_enabled BOOLEAN DEFAULT FALSE,
    failed_login_attempts INT DEFAULT 0,
    locked_until TIMESTAMP NULL,
    last_login_at TIMESTAMP NULL,
    last_login_ip VARCHAR(45) NULL,
    language VARCHAR(10) DEFAULT 'en',
    timezone VARCHAR(50) DEFAULT 'Asia/Dhaka',
    notification_preferences JSON NULL,
    email_verified_at TIMESTAMP NULL,
    phone_verified_at TIMESTAMP NULL,
    remember_token VARCHAR(100) NULL,
    password_reset_token VARCHAR(255) NULL,
    password_reset_expires_at TIMESTAMP NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP NULL,
    INDEX idx_users_role_status (role, status),
    INDEX idx_users_name (first_name, last_name),
    INDEX idx_users_blood_group (blood_group),
    INDEX idx_users_city (city),
    INDEX idx_users_location (latitude, longitude),
    INDEX idx_users_created (created_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- ============================================
-- TABLE 2: SESSIONS
-- ============================================
CREATE TABLE IF NOT EXISTS sessions (
    id VARCHAR(255) PRIMARY KEY,
    user_id BIGINT UNSIGNED NULL,
    ip_address VARCHAR(45) NULL,
    user_agent TEXT NULL,
    payload TEXT NOT NULL,
    last_activity INT NOT NULL,
    INDEX idx_sessions_user (user_id),
    INDEX idx_sessions_activity (last_activity),
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- ============================================
-- TABLE 3: DOCTORS
-- ============================================
CREATE TABLE IF NOT EXISTS doctors (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT UNSIGNED NOT NULL UNIQUE,
    license_number VARCHAR(100) NOT NULL UNIQUE,
    bmdc_registration VARCHAR(50) NULL UNIQUE,
    specialization VARCHAR(255) NOT NULL,
    sub_specializations JSON NULL,
    qualifications JSON NULL,
    experience_years INT DEFAULT 0,
    about TEXT NULL,
    languages_spoken JSON NULL,
    consultation_fee DECIMAL(10,2) NOT NULL DEFAULT 500.00,
    follow_up_fee DECIMAL(10,2) NULL,
    currency VARCHAR(3) DEFAULT 'BDT',
    max_patients_per_day INT DEFAULT 30,
    appointment_duration_minutes INT DEFAULT 30,
    available_days SET('saturday','sunday','monday','tuesday','wednesday','thursday','friday') NULL,
    available_from TIME DEFAULT '09:00:00',
    available_to TIME DEFAULT '17:00:00',
    break_from TIME DEFAULT '13:00:00',
    break_to TIME DEFAULT '14:00:00',
    is_verified BOOLEAN DEFAULT FALSE,
    is_available BOOLEAN DEFAULT TRUE,
    is_featured BOOLEAN DEFAULT FALSE,
    accepting_new_patients BOOLEAN DEFAULT TRUE,
    is_online BOOLEAN DEFAULT FALSE,
    offers_online_consultation BOOLEAN DEFAULT TRUE,
    offers_home_visit BOOLEAN DEFAULT FALSE,
    average_rating DECIMAL(3,2) DEFAULT 0.00,
    total_reviews INT DEFAULT 0,
    total_patients INT DEFAULT 0,
    total_appointments INT DEFAULT 0,
    bank_name VARCHAR(255) NULL,
    bank_account_number VARCHAR(50) NULL,
    bank_routing_number VARCHAR(50) NULL,
    profile_photo VARCHAR(500) NULL,
    license_image VARCHAR(500) NULL,
    certificates JSON NULL,
    website VARCHAR(255) NULL,
    linkedin VARCHAR(255) NULL,
    facebook VARCHAR(255) NULL,
    slug VARCHAR(255) NULL UNIQUE,
    verified_at TIMESTAMP NULL,
    last_online_at TIMESTAMP NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP NULL,
    INDEX idx_doctors_specialization (specialization),
    INDEX idx_doctors_fee (consultation_fee),
    INDEX idx_doctors_rating (average_rating),
    INDEX idx_doctors_experience (experience_years),
    INDEX idx_doctors_available (is_available),
    INDEX idx_doctors_online (is_online),
    INDEX idx_doctors_featured (is_featured, average_rating),
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- ============================================
-- TABLE 4: DOCTOR_AVAILABILITY
-- ============================================
CREATE TABLE IF NOT EXISTS doctor_availability (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    doctor_id BIGINT UNSIGNED NOT NULL,
    day_of_week ENUM('saturday','sunday','monday','tuesday','wednesday','thursday','friday') NOT NULL,
    start_time TIME NOT NULL,
    end_time TIME NOT NULL,
    slot_duration_minutes INT DEFAULT 30,
    max_patients_per_slot INT DEFAULT 1,
    is_available BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    UNIQUE INDEX idx_avail_unique (doctor_id, day_of_week, start_time, end_time),
    FOREIGN KEY (doctor_id) REFERENCES doctors(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- ============================================
-- TABLE 5: DOCTOR_LEAVES
-- ============================================
CREATE TABLE IF NOT EXISTS doctor_leaves (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    doctor_id BIGINT UNSIGNED NOT NULL,
    leave_date DATE NOT NULL,
    start_time TIME NULL,
    end_time TIME NULL,
    reason VARCHAR(255) NULL,
    leave_type ENUM('full_day','half_day','emergency') DEFAULT 'full_day',
    status ENUM('pending','approved','rejected') DEFAULT 'pending',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    UNIQUE INDEX idx_leave_unique (doctor_id, leave_date),
    FOREIGN KEY (doctor_id) REFERENCES doctors(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- ============================================
-- TABLE 6: HOSPITALS
-- ============================================
CREATE TABLE IF NOT EXISTS hospitals (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    slug VARCHAR(255) NOT NULL UNIQUE,
    registration_number VARCHAR(100) NULL UNIQUE,
    email VARCHAR(255) NULL,
    phone VARCHAR(20) NULL,
    emergency_phone VARCHAR(20) NULL,
    ambulance_phone VARCHAR(20) NULL,
    fax VARCHAR(20) NULL,
    website VARCHAR(255) NULL,
    address TEXT NOT NULL,
    city VARCHAR(100) NOT NULL,
    state VARCHAR(100) NULL,
    country VARCHAR(100) DEFAULT 'Bangladesh',
    postal_code VARCHAR(20) NULL,
    latitude DECIMAL(10,8) NOT NULL,
    longitude DECIMAL(11,8) NOT NULL,
    hospital_type ENUM('government','private','clinic','diagnostic_center','specialized','teaching','military','ngo','corporate') NOT NULL,
    category ENUM('primary','secondary','tertiary','super_specialty') DEFAULT 'secondary',
    accreditation JSON NULL,
    total_beds INT DEFAULT 0,
    icu_beds INT DEFAULT 0,
    nicu_beds INT DEFAULT 0,
    emergency_beds INT DEFAULT 0,
    operation_theaters INT DEFAULT 0,
    icu_available INT DEFAULT 0,
    general_beds_available INT DEFAULT 0,
    emergency_beds_available INT DEFAULT 0,
    has_emergency_services BOOLEAN DEFAULT TRUE,
    has_ambulance_service BOOLEAN DEFAULT TRUE,
    has_pharmacy BOOLEAN DEFAULT TRUE,
    has_laboratory BOOLEAN DEFAULT TRUE,
    has_radiology BOOLEAN DEFAULT TRUE,
    has_blood_bank BOOLEAN DEFAULT TRUE,
    has_icu BOOLEAN DEFAULT TRUE,
    has_nicu BOOLEAN DEFAULT FALSE,
    has_burn_unit BOOLEAN DEFAULT FALSE,
    has_dialysis_unit BOOLEAN DEFAULT FALSE,
    has_cath_lab BOOLEAN DEFAULT FALSE,
    has_cancer_center BOOLEAN DEFAULT FALSE,
    has_cafeteria BOOLEAN DEFAULT FALSE,
    has_parking BOOLEAN DEFAULT FALSE,
    has_wifi BOOLEAN DEFAULT FALSE,
    has_atm BOOLEAN DEFAULT FALSE,
    has_prayer_room BOOLEAN DEFAULT FALSE,
    accepted_insurances JSON NULL,
    payment_methods JSON NULL,
    logo VARCHAR(500) NULL,
    cover_image VARCHAR(500) NULL,
    images JSON NULL,
    opening_time TIME DEFAULT '00:00:00',
    closing_time TIME DEFAULT '23:59:59',
    is_24x7 BOOLEAN DEFAULT FALSE,
    visiting_hours JSON NULL,
    emergency_hours VARCHAR(100) DEFAULT '24/7',
    average_rating DECIMAL(3,2) DEFAULT 0.00,
    total_reviews INT DEFAULT 0,
    total_doctors INT DEFAULT 0,
    is_active BOOLEAN DEFAULT TRUE,
    is_verified BOOLEAN DEFAULT FALSE,
    is_featured BOOLEAN DEFAULT FALSE,
    admin_user_id BIGINT UNSIGNED NULL,
    established_year YEAR NULL,
    facebook VARCHAR(255) NULL,
    youtube VARCHAR(255) NULL,
    meta_title VARCHAR(255) NULL,
    meta_description TEXT NULL,
    verified_at TIMESTAMP NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP NULL,
    INDEX idx_hosp_name (name),
    INDEX idx_hosp_type (hospital_type, category),
    INDEX idx_hosp_city (city, state),
    INDEX idx_hosp_location (latitude, longitude),
    INDEX idx_hosp_beds (total_beds, icu_beds, emergency_beds),
    INDEX idx_hosp_emergency (has_emergency_services),
    INDEX idx_hosp_rating (average_rating),
    INDEX idx_hosp_featured (is_featured),
    INDEX idx_hosp_active (is_active, is_verified),
    FOREIGN KEY (admin_user_id) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- ============================================
-- TABLE 7: HOSPITAL_DEPARTMENTS
-- ============================================
CREATE TABLE IF NOT EXISTS hospital_departments (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    hospital_id BIGINT UNSIGNED NOT NULL,
    department_name VARCHAR(255) NOT NULL,
    description TEXT NULL,
    head_doctor_id BIGINT UNSIGNED NULL,
    total_beds INT DEFAULT 0,
    available_beds INT DEFAULT 0,
    phone_extension VARCHAR(20) NULL,
    floor_number VARCHAR(20) NULL,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    UNIQUE INDEX idx_dept_unique (hospital_id, department_name),
    FOREIGN KEY (hospital_id) REFERENCES hospitals(id) ON DELETE CASCADE,
    FOREIGN KEY (head_doctor_id) REFERENCES doctors(id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- ============================================
-- TABLE 8: DOCTOR_HOSPITAL
-- ============================================
CREATE TABLE IF NOT EXISTS doctor_hospital (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    doctor_id BIGINT UNSIGNED NOT NULL,
    hospital_id BIGINT UNSIGNED NOT NULL,
    department_id BIGINT UNSIGNED NULL,
    available_days SET('saturday','sunday','monday','tuesday','wednesday','thursday','friday') NULL,
    available_from TIME NULL,
    available_to TIME NULL,
    consultation_fee DECIMAL(10,2) NULL,
    room_number VARCHAR(50) NULL,
    office_phone VARCHAR(20) NULL,
    is_active BOOLEAN DEFAULT TRUE,
    is_primary BOOLEAN DEFAULT FALSE,
    joined_at DATE NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    UNIQUE INDEX idx_dh_unique (doctor_id, hospital_id),
    INDEX idx_dh_doctor (doctor_id),
    INDEX idx_dh_hospital (hospital_id),
    FOREIGN KEY (doctor_id) REFERENCES doctors(id) ON DELETE CASCADE,
    FOREIGN KEY (hospital_id) REFERENCES hospitals(id) ON DELETE CASCADE,
    FOREIGN KEY (department_id) REFERENCES hospital_departments(id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- ============================================
-- TABLE 9: PATIENTS
-- ============================================
CREATE TABLE IF NOT EXISTS patients (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT UNSIGNED NOT NULL UNIQUE,
    patient_id_number VARCHAR(50) NULL UNIQUE,
    emergency_contact_name VARCHAR(255) NULL,
    emergency_contact_phone VARCHAR(20) NULL,
    emergency_contact_relation VARCHAR(100) NULL,
    emergency_contact_email VARCHAR(255) NULL,
    height_cm DECIMAL(5,2) NULL,
    weight_kg DECIMAL(5,2) NULL,
    bmi DECIMAL(5,2) NULL,
    allergies JSON NULL,
    chronic_diseases JSON NULL,
    current_medications JSON NULL,
    past_surgeries JSON NULL,
    family_history JSON NULL,
    medical_conditions TEXT NULL,
    surgical_history TEXT NULL,
    smoking_status ENUM('never','former','current','occasional') NULL,
    alcohol_consumption ENUM('never','occasional','regular','former') NULL,
    exercise_frequency ENUM('never','rarely','weekly','daily','athlete') NULL,
    dietary_preference ENUM('vegetarian','non_vegetarian','vegan','keto','other') NULL,
    insurance_provider VARCHAR(255) NULL,
    insurance_policy_number VARCHAR(100) NULL,
    insurance_expiry_date DATE NULL,
    insurance_coverage_details JSON NULL,
    occupation VARCHAR(255) NULL,
    marital_status ENUM('single','married','divorced','widowed') NULL,
    is_active BOOLEAN DEFAULT TRUE,
    is_vip BOOLEAN DEFAULT FALSE,
    last_visit_at TIMESTAMP NULL,
    total_visits INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP NULL,
    INDEX idx_patients_insurance (insurance_provider),
    INDEX idx_patients_vip (is_vip),
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- ============================================
-- TABLE 10: APPOINTMENTS
-- ============================================
CREATE TABLE IF NOT EXISTS appointments (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    appointment_number VARCHAR(50) NOT NULL UNIQUE,
    serial_number INT NULL,
    patient_id BIGINT UNSIGNED NOT NULL,
    doctor_id BIGINT UNSIGNED NOT NULL,
    hospital_id BIGINT UNSIGNED NULL,
    department_id BIGINT UNSIGNED NULL,
    appointment_date DATE NOT NULL,
    appointment_time TIME NOT NULL,
    end_time TIME NULL,
    duration_minutes INT DEFAULT 30,
    appointment_type ENUM('in_person','online','home_visit','emergency','follow_up','lab_test','vaccination','consultation') NOT NULL DEFAULT 'in_person',
    queue_number INT NULL,
    queue_status ENUM('waiting','in_progress','completed','skipped') NULL,
    status ENUM('pending','confirmed','checked_in','in_progress','completed','cancelled','no_show','rescheduled') NOT NULL DEFAULT 'pending',
    patient_name VARCHAR(255) NOT NULL,
    patient_phone VARCHAR(20) NOT NULL,
    patient_email VARCHAR(255) NULL,
    patient_age INT NULL,
    patient_gender ENUM('male','female','other') NULL,
    patient_blood_group ENUM('A+','A-','B+','B-','AB+','AB-','O+','O-') NULL,
    symptoms JSON NULL,
    reason_for_visit TEXT NULL,
    is_emergency BOOLEAN DEFAULT FALSE,
    previous_appointment_id BIGINT UNSIGNED NULL,
    consultation_fee DECIMAL(10,2) NOT NULL DEFAULT 0.00,
    service_charge DECIMAL(10,2) DEFAULT 0.00,
    discount_amount DECIMAL(10,2) DEFAULT 0.00,
    total_amount DECIMAL(10,2) NOT NULL DEFAULT 0.00,
    payment_status ENUM('pending','partial','paid','refunded','failed') DEFAULT 'pending',
    payment_method ENUM('cash','card','mobile_banking','insurance','online','bkash','nagad') NULL,
    payment_id VARCHAR(255) NULL,
    payment_date TIMESTAMP NULL,
    meeting_link VARCHAR(500) NULL,
    meeting_platform ENUM('zoom','google_meet','microsoft_teams','custom') NULL,
    meeting_id VARCHAR(100) NULL,
    meeting_password VARCHAR(100) NULL,
    doctor_notes TEXT NULL,
    patient_notes TEXT NULL,
    cancellation_reason TEXT NULL,
    rescheduled_reason TEXT NULL,
    patient_rating DECIMAL(3,2) NULL,
    patient_feedback TEXT NULL,
    rated_at TIMESTAMP NULL,
    confirmed_at TIMESTAMP NULL,
    checked_in_at TIMESTAMP NULL,
    started_at TIMESTAMP NULL,
    completed_at TIMESTAMP NULL,
    cancelled_at TIMESTAMP NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP NULL,
    INDEX idx_app_patient (patient_id, appointment_date),
    INDEX idx_app_doctor (doctor_id, appointment_date),
    INDEX idx_app_hospital (hospital_id, appointment_date),
    INDEX idx_app_status (status, appointment_date),
    INDEX idx_app_date (appointment_date, appointment_time),
    INDEX idx_app_payment (payment_status),
    INDEX idx_app_queue (serial_number, queue_status),
    INDEX idx_app_type (appointment_type),
    INDEX idx_app_emergency (is_emergency, status),
    FOREIGN KEY (patient_id) REFERENCES patients(id) ON DELETE CASCADE,
    FOREIGN KEY (doctor_id) REFERENCES doctors(id) ON DELETE CASCADE,
    FOREIGN KEY (hospital_id) REFERENCES hospitals(id) ON DELETE SET NULL,
    FOREIGN KEY (department_id) REFERENCES hospital_departments(id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- ============================================
-- TABLE 11: MEDICAL_RECORDS
-- ============================================
CREATE TABLE IF NOT EXISTS medical_records (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    record_number VARCHAR(50) NOT NULL UNIQUE,
    patient_id BIGINT UNSIGNED NOT NULL,
    doctor_id BIGINT UNSIGNED NULL,
    appointment_id BIGINT UNSIGNED NULL,
    hospital_id BIGINT UNSIGNED NULL,
    record_type ENUM('consultation','lab_report','radiology','prescription','surgery','vaccination','allergy','diagnosis','emergency','follow_up','annual_checkup','other') NOT NULL,
    blood_pressure_systolic INT NULL,
    blood_pressure_diastolic INT NULL,
    heart_rate INT NULL,
    respiratory_rate INT NULL,
    temperature_celsius DECIMAL(4,1) NULL,
    oxygen_saturation DECIMAL(5,2) NULL,
    blood_sugar DECIMAL(6,2) NULL,
    vital_signs JSON NULL,
    chief_complaint TEXT NULL,
    diagnosis TEXT NULL,
    differential_diagnosis TEXT NULL,
    symptoms JSON NULL,
    treatment_plan TEXT NULL,
    doctor_notes TEXT NULL,
    nurse_notes TEXT NULL,
    physical_examination TEXT NULL,
    systemic_examination JSON NULL,
    lab_tests JSON NULL,
    lab_results JSON NULL,
    lab_report_url VARCHAR(500) NULL,
    radiology_type ENUM('xray','mri','ct_scan','ultrasound','ecg','echo','mammogram','angiogram','other') NULL,
    radiology_findings TEXT NULL,
    radiology_images JSON NULL,
    radiology_report_url VARCHAR(500) NULL,
    attachments JSON NULL,
    is_confidential BOOLEAN DEFAULT FALSE,
    requires_follow_up BOOLEAN DEFAULT FALSE,
    follow_up_date DATE NULL,
    follow_up_instructions TEXT NULL,
    icd10_codes JSON NULL,
    record_date DATE NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP NULL,
    INDEX idx_rec_patient (patient_id, record_date),
    INDEX idx_rec_doctor (doctor_id),
    INDEX idx_rec_type (record_type),
    INDEX idx_rec_date (record_date),
    INDEX idx_rec_followup (requires_follow_up, follow_up_date),
    INDEX idx_rec_appointment (appointment_id),
    INDEX idx_rec_hospital (hospital_id),
    FOREIGN KEY (patient_id) REFERENCES patients(id) ON DELETE CASCADE,
    FOREIGN KEY (doctor_id) REFERENCES doctors(id) ON DELETE SET NULL,
    FOREIGN KEY (appointment_id) REFERENCES appointments(id) ON DELETE SET NULL,
    FOREIGN KEY (hospital_id) REFERENCES hospitals(id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- ============================================
-- TABLE 12: PRESCRIPTIONS
-- ============================================
CREATE TABLE IF NOT EXISTS prescriptions (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    prescription_number VARCHAR(50) NOT NULL UNIQUE,
    patient_id BIGINT UNSIGNED NOT NULL,
    doctor_id BIGINT UNSIGNED NOT NULL,
    appointment_id BIGINT UNSIGNED NULL,
    medical_record_id BIGINT UNSIGNED NULL,
    medicines JSON NOT NULL,
    diagnosis TEXT NULL,
    instructions TEXT NULL,
    diet_advice TEXT NULL,
    exercise_advice TEXT NULL,
    prescribed_date DATE NOT NULL,
    valid_until DATE NULL,
    next_review_date DATE NULL,
    status ENUM('active','completed','cancelled','expired','discontinued') DEFAULT 'active',
    is_dispensed BOOLEAN DEFAULT FALSE,
    dispensed_at TIMESTAMP NULL,
    dispensed_by BIGINT UNSIGNED NULL,
    digital_signature VARCHAR(500) NULL,
    qr_code VARCHAR(500) NULL,
    printed_at TIMESTAMP NULL,
    print_count INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP NULL,
    INDEX idx_pres_patient (patient_id, prescribed_date),
    INDEX idx_pres_doctor (doctor_id, prescribed_date),
    INDEX idx_pres_status (status),
    INDEX idx_pres_dispensed (is_dispensed),
    INDEX idx_pres_validity (valid_until),
    FOREIGN KEY (patient_id) REFERENCES patients(id) ON DELETE CASCADE,
    FOREIGN KEY (doctor_id) REFERENCES doctors(id) ON DELETE CASCADE,
    FOREIGN KEY (appointment_id) REFERENCES appointments(id) ON DELETE SET NULL,
    FOREIGN KEY (medical_record_id) REFERENCES medical_records(id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- ============================================
-- TABLE 13: PHARMACIES
-- ============================================
CREATE TABLE IF NOT EXISTS pharmacies (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    license_number VARCHAR(100) NOT NULL UNIQUE,
    phone VARCHAR(20) NULL,
    alternate_phone VARCHAR(20) NULL,
    email VARCHAR(255) NULL,
    website VARCHAR(255) NULL,
    address TEXT NOT NULL,
    city VARCHAR(100) NOT NULL,
    state VARCHAR(100) NULL,
    postal_code VARCHAR(20) NULL,
    latitude DECIMAL(10,8) NOT NULL,
    longitude DECIMAL(11,8) NOT NULL,
    opening_time TIME NOT NULL DEFAULT '08:00:00',
    closing_time TIME NOT NULL DEFAULT '22:00:00',
    is_24x7 BOOLEAN DEFAULT FALSE,
    is_open_now BOOLEAN DEFAULT TRUE,
    offers_delivery BOOLEAN DEFAULT FALSE,
    delivery_radius_km DECIMAL(5,2) NULL,
    minimum_order_amount DECIMAL(10,2) DEFAULT 0.00,
    delivery_charge DECIMAL(10,2) DEFAULT 0.00,
    accepts_prescriptions_online BOOLEAN DEFAULT FALSE,
    offers_pharmacist_consultation BOOLEAN DEFAULT FALSE,
    is_active BOOLEAN DEFAULT TRUE,
    is_verified BOOLEAN DEFAULT FALSE,
    is_featured BOOLEAN DEFAULT FALSE,
    average_rating DECIMAL(3,2) DEFAULT 0.00,
    total_reviews INT DEFAULT 0,
    logo VARCHAR(500) NULL,
    images JSON NULL,
    pharmacist_name VARCHAR(255) NULL,
    pharmacist_license VARCHAR(100) NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP NULL,
