  "description": "Aetherion Smart Healthcare Ecosystem Frontend",
  "author": "Pollob Das",
  "license": "MIT",
  "keywords": [
    "hospital",
    "healthcare",
    "blood-bank",
    "doctor-appointment",
    "react",
    "vite",
    "typescript",
    "firebase",
    "dashboard"
